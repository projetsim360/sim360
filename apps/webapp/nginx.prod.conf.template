# Map host+uri → routing decision. Using a single map per concern is more
# reliable than nginx's "if + set" combos at server level (well-known footgun).
# Value semantics: empty string = no action (default), non-empty = take action.

map $host:$uri $bounce_apex_non_root {
    default "";

    # Exclusions evaluated first (nginx walks regexes in order, stops on first hit).
    # Static assets and API calls must be served from the same origin to avoid
    # CORS on the bundled JS/CSS the SPA loads.
    "~^simex-pro\.com:/assets/" "";
    "~^simex-pro\.com:/api/" "";
    "~^simex-pro\.com:/socket\.io/" "";
    "~^simex-pro\.com:/health$" "";
    # Static media and fonts of the public site must stay on the apex: a redirect to the app
    # host makes <video>, <track> and font requests cross-origin (CORS, "unsafe attempt to load").
    "~^simex-pro\.com:/media/" "";
    "~^simex-pro\.com:/fonts/" "";
    "~^simex-pro\.com:[^?]+\.(js|css|map|json|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|txt|xml|webmanifest|mp4|webm|vtt)$" "";

    # Public site pages (served by site.html) stay on the apex: French at "/", English under "/en".
    # Keep in sync with apps/webapp/public-paths.ts and the $spa_entry map below.
    "~^simex-pro\.com:/en(/|$)" "";
    "~^simex-pro\.com:/(scenarios|demo|a-propos|carrieres|contact|confidentialite|cgu|mentions-legales|cookies)/?$" "";

    # Anything else under apex (real "page" routes) → bounce to app subdomain.
    "~^simex-pro\.com:/.+$" 1;
}

map $host:$uri $bounce_app_root {
    default "";
    # app.simex-pro.com or web.simex-pro.com with a public site path → bounce to apex
    "~^(app|web)\.simex-pro\.com:/$" 1;
    "~^(app|web)\.simex-pro\.com:/en(/|$)" 1;
    "~^(app|web)\.simex-pro\.com:/(scenarios|demo|a-propos|carrieres|contact|confidentialite|cgu|mentions-legales|cookies)/?$" 1;
}

# Which SPA entry serves a non-file URL: the public site (small bundle) or the application.
# Keep in sync with apps/webapp/public-paths.ts.
map $uri $spa_entry {
    default /index.html;
    "/" /site-fr.html;
    "/en" /site-en.html;
    "~^/scenarios/?$" /site-fr-scenarios.html;
    "~^/en/scenarios/?$" /site-en-scenarios.html;
    "~^/demo/?$" /site-fr-demo.html;
    "~^/en/demo/?$" /site-en-demo.html;
    "~^/a-propos/?$" /site-fr-about.html;
    "~^/en/about/?$" /site-en-about.html;
    "~^/carrieres/?$" /site-fr-careers.html;
    "~^/en/careers/?$" /site-en-careers.html;
    "~^/contact/?$" /site-fr-contact.html;
    "~^/en/contact/?$" /site-en-contact.html;
    "~^/confidentialite/?$" /site-fr-privacy.html;
    "~^/en/privacy/?$" /site-en-privacy.html;
    "~^/cgu/?$" /site-fr-terms.html;
    "~^/en/terms/?$" /site-en-terms.html;
    "~^/mentions-legales/?$" /site-fr-legal.html;
    "~^/en/legal/?$" /site-en-legal.html;
    "~^/cookies/?$" /site-fr-cookies.html;
    "~^/en/cookies/?$" /site-en-cookies.html;
    "~^/en/" /site.html;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # simex-pro.com (apex) — only "/" stays here; deeper paths go to app.
    if ($bounce_apex_non_root) {
        return 301 https://app.simex-pro.com$request_uri;
    }

    # app./web.simex-pro.com — public site paths go back to the apex.
    if ($bounce_app_root) {
        return 301 https://simex-pro.com$request_uri;
    }

    # Socket.io (notifications gateway) — needs WebSocket upgrade and no buffering.
    # Long-lived connection, so read/send timeouts are raised well above the default 60s.
    location /socket.io/ {
        proxy_pass http://kp--simex-pro--simexpro-api--staging:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Proxy API calls to the internal Kapapra API service (Docker Swarm overlay DNS).
    # Same-origin so no CORS needed; clients reach the API via the webapp's domain.
    location /api/v1/ {
        proxy_pass http://kp--simex-pro--simexpro-api--staging:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Uploaded files (avatars, ...) are served by the API. `^~` is required so this
    # prefix wins over the static-asset regex below (which would 404 on .png/.webp).
    location ^~ /uploads/ {
        proxy_pass http://kp--simex-pro--simexpro-api--staging:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
        add_header Cache-Control "public";
    }

    # SPA routing — non-file requests go to the public site or the application entry
    location / {
        try_files $uri $uri/ $spa_entry;
    }

    # Static assets — long cache with immutable
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm|vtt)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Disable access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
