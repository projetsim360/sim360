{
  "name": "@sim360/root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test:smoke": "node tests/e2e/retours-test.smoke.mjs",
    "test:smoke:landing": "node tests/e2e/landing.smoke.mjs",
    "test:smoke:public": "node tests/e2e/public-pages.smoke.mjs",
    "test:a11y:public": "node tests/e2e/a11y.smoke.mjs",
    "demo:video": "node tools/demo-video/run.mjs",
    "demo:promo:check": "cd tools/demo-video/promo && npm run check",
    "demo:promo:render": "cd tools/demo-video/promo && npx --yes hyperframes@0.8.146 render --quiet -q delivery --crf 24 -o renders/demo-fr.mp4 && npx --yes hyperframes@0.8.146 render --quiet -q delivery --crf 24 -o renders/demo-en.mp4 --variables-file variables.en.json",
    "demo:promo:publish": "node tools/demo-video/promo/publish.mjs",
    "test:unit": "pnpm test:unit:core && pnpm test:unit:api && pnpm test:unit:webapp",
    "test:unit:core": "tsx --tsconfig libs/core/tsconfig.json --test libs/core/test/*.test.ts",
    "test:unit:api": "tsx --tsconfig apps/api/tsconfig.json --test apps/api/test/*.test.ts",
    "test:unit:webapp": "tsx --tsconfig apps/webapp/tsconfig.app.json --test apps/webapp/tests/unit/*.test.ts",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "prepare": "echo 'husky not yet configured'"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "prisma": "^6.9.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
