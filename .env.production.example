# ─── Application ───────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
APP_URL=https://app.sim360.dev
API_URL=https://api.sim360.dev

# ─── Database (PostgreSQL) ─────────────────────────────────
# For docker-compose.prod.yml, DATABASE_URL is set automatically.
# For Railway/external DB, set this directly:
DATABASE_URL=postgresql://user:password@host:5432/sim360_prod

# Docker Compose specific:
POSTGRES_USER=sim360
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sim360_prod

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT Auth (MUST change in production!) ─────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── 2FA Encryption ───────────────────────────────────────
# Exactly 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
# If missing or invalid, the API still starts but 2FA setup is refused.
TWO_FACTOR_ENCRYPTION_KEY=

# ─── AI Providers ─────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic

# ─── File storage (avatars) ───────────────────────────────
# local → files under /app/uploads, which MUST be a persistent volume (lost on redeploy otherwise)
# gcs   → Google Cloud Storage; no volume needed, files survive redeploys and server moves.
#         Bucket: uniform bucket-level access + allUsers: Storage Object Viewer (avatars are public).
#         Service account: Storage Object Admin on that bucket only.
STORAGE_PROVIDER=local
GCS_BUCKET=simex-pro-uploads
GCS_PROJECT_ID=
# Paste the full service-account key JSON here (single line). Avoids mounting a key file in the container.
GCS_KEY_JSON=
GCS_KEY_FILE=

# ─── Email ───────────────────────────────────────────────
# Provider is picked at runtime, in this order:
#   1. RESEND_API_KEY set        → Resend HTTP API  (required on Railway:
#                                  outbound SMTP ports 25/465/587 are blocked)
#   2. SMTP_HOST set             → nodemailer SMTP  (local dev / MailHog)
#   3. neither                   → emails logged, never sent
#
# Production = Resend. Set RESEND_API_KEY and leave SMTP_* unset.
RESEND_API_KEY=

# Sender address, used by BOTH providers.
# Must be on a domain verified in the Resend dashboard, otherwise sending fails.
# The fallback onboarding@resend.dev only delivers to your own Resend account email.
SMTP_FROM=noreply@sim360.dev

# SMTP fallback — leave empty in production (see priority order above).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.sim360.dev/api/v1/auth/google/callback

# ─── Firebase Cloud Messaging ─────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Docker Compose Ports (optional overrides) ────────────
API_PORT=3001
WEBAPP_PORT=80
VITE_API_URL=/api/v1
